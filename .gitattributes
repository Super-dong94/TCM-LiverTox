* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.bat text eol=crlf
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.html text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Runtime datasets and trained model binaries are stored with Git LFS.
data/*.csv filter=lfs diff=lfs merge=lfs -text
data/*.sqlite filter=lfs diff=lfs merge=lfs -text
models/*.joblib filter=lfs diff=lfs merge=lfs -text
